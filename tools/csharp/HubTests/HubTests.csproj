<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native test for the hub report engine. The engine itself is compiled from the Blazor project's
       source file (shared/csharp-achievements/GenreReportCore.cs), so what is tested is what ships.
       Run: source /opt/tc/env.sh, then: dotnet run -c Release (from this folder), passing the repo root as the first program argument. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../shared/csharp-achievements/GenreReportCore.cs" Link="GenreReportCore.cs" />
  </ItemGroup>

</Project>
